# Local development examples only; replace these values for your environment.
DATABASE_URL=postgres://cortex:cortex@127.0.0.1:5432/cortex?sslmode=disable
LLM_BASE_URL=http://127.0.0.1:8088/v1
LLM_API_KEY=
CORTEX_MODEL=gpt-6-luna-medium
CORTEX_LISTEN=127.0.0.1:8090
# Optional independent OpenAI-compatible embedding endpoint.
CORTEX_EMBEDDING_URL=http://127.0.0.1:8091/v1
CORTEX_EMBEDDING_MODEL=
CORTEX_EMBEDDING_KEY=

# Optional shadow classifier; explicit /v1/classify calls only.
CORTEX_CLASSIFIER_URL=
CORTEX_CLASSIFIER_MODEL=
CORTEX_CLASSIFIER_KEY=

# Optional exact-tokenizer segmentation; set all three non-secret fields.
# This endpoint receives raw sources during window indexing and recall.
CORTEX_SEGMENTER_URL=
CORTEX_SEGMENTER_ID=
CORTEX_SEGMENTER_MAX_TOKENS=
CORTEX_SEGMENTER_KEY=
